# Shuffle Security Environment Configuration

# Backend API base URL
# Default: http://localhost:5001 or window.location.origin
# VITE_SHUFFLE_API_URL=http://localhost:5001
# SHUFFLE_API_URL=http://localhost:5001

# Shuffle Core Frontend URL
# Overrides where Shuffle Core is hosted. Used for links to /workflows, /workflows/:id, admin tabs, etc.
# Default on Cloud: https://shuffler.io
# Default on Prem / Docker: http://<current-host>:3001
# VITE_SHUFFLE_CORE_URL=http://localhost:3001
# SHUFFLE_CORE_URL=http://localhost:3001

# Shuffle Security Frontend URL
# Overrides where Shuffle Security is hosted.
# Default on Cloud: https://shuffle.security
# Default on Prem / Docker: http://<current-host>:3002 or window.location.origin
# VITE_SHUFFLE_SECURITY_URL=http://localhost:3002
# SHUFFLE_SECURITY_URL=http://localhost:3002
